{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/girls_dict.schema.json",
  "title": "girls_dict 完整 JSON 格式 v2",
  "description": "用于导入、导出及 JSON 文件模式。必须使用当前版本，不含内部 id；未知字段会被拒绝。SQLite 存储版本独立于本 JSON 版本。",
  "type": "object",
  "required": ["schema", "schemaVersion", "meta", "chapters"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "girls_dict" },
    "schemaVersion": { "const": 2 },
    "exportedAt": { "type": ["string", "null"], "description": "可选导出时间；导入 SQLite 时不恢复此时间。" },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "JSON 文件模式的版本号；导入 SQLite 时由目标库维护版本号。" },
    "meta": {
      "type": "object",
      "required": ["title", "author", "charMin", "charMax", "charNames"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "charMin": { "const": 0 },
        "charMax": { "const": 100 },
        "charNames": {
          "type": "object",
          "propertyNames": { "pattern": "^(0|[1-9][0-9]?|100)$" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "chapters": {
      "type": "array",
      "description": "数组顺序就是话顺序。运行时另行校验 no 必须等于数组下标 + 1。",
      "items": {
        "type": "object",
        "required": ["no", "title", "note", "panels"],
        "additionalProperties": false,
        "properties": {
          "no": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "note": { "type": "string" },
          "panels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["chars"],
              "additionalProperties": false,
              "properties": {
                "chars": {
                  "type": "array",
                  "description": "唯一且升序的角色编号；升序由运行时校验。",
                  "uniqueItems": true,
                  "items": { "type": "integer", "minimum": 0, "maximum": 100 }
                }
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "schema": "girls_dict", "schemaVersion": 2,
      "meta": { "title": "超超你的字典", "author": "", "charMin": 0, "charMax": 100, "charNames": { "1": "超超", "5": "阿蓝" } },
      "chapters": [{ "no": 1, "title": "相遇", "note": "", "panels": [{ "chars": [1, 5] }] }]
    }
  ]
}
